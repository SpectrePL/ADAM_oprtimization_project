        <experiment id="EXP_P_007">
            <name>Rosenbrock - liniowe ograniczenie rownosciowe</name>
            <function_name>Rosenbrock</function_name>
            <start_point>
                <coordinate>-5.0</coordinate>
                <coordinate>10.0</coordinate>
            </start_point>
            <is_constrained>true</is_constrained>
            
            <penalty_config>
                <r>500.0</r>
                <constraints>
                    <constraint type="equality">
                        <class_name>Wartosc_Kary</class_name>
                        <parameters>
                            <param name="a">-0.5</param>
                            <param name="b">-1.0</param>
                            <param name="c">1.5</param>
                        </parameters>
                    </constraint>
                </constraints>
            </penalty_config>
        </experiment>


        <experiment id="EXP_P_008">
            <name>Three Hump Camel - ograniczenie kolowe</name>
            <function_name>Three_Hump</function_name>
            <start_point>
                <coordinate>-1.0</coordinate>
                <coordinate>1.0</coordinate>
            </start_point>
            <is_constrained>true</is_constrained>
            
            <penalty_config>
                <r>500.0</r>
                <constraints>
                    <constraint type="inequality">
                        <class_name>Constraint_Circle</class_name>
                        <parameters>
                            <param name="c">1.0</param>
                        </parameters>
                    </constraint>
                </constraints>
            </penalty_config>
        </experiment>

